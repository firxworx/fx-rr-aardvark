{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/*.sql",
      "!**/drizzle",
      "!**/migrations",
      "!**/coverage",
      "!**/node_modules/**/*",
      "!**/dist/**/*",
      "!**/build/**/*",
      "!**/.react-router/**/*",
      "!**/worker-configuration.d.ts",
      "!**/pnpm-lock.yaml",
      "!**/apps/**/fonts.css",
      "!**/apps/**/public/**/*.svg",
      "!.vscode/**/*.code-snippets"

      // examples to disable biome for certain files/folders
      // "!**/packages/ui/src/_shadcn/**/*", // when using custom directory for cli-managed components
      // "!**/packages/ui/src/**/*", // disable biome for all ui package source files
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "formatWithErrors": true,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "jsxQuoteStyle": "double"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
      "allowWrongLineComments": false,
      "cssModules": false
    }
  },
  // https://biomejs.dev/reference/configuration/#markdown
  "markdown": {
    "parser": {
      // required: when disabled the formatter treats `---` frontmatter as markdown and breaks it
      "frontmatter": true,
      "gfm": true
    },
    "formatter": {
      "enabled": true,
      "proseWrap": "preserve",
      // fenced code blocks are formatted per the matching language config (e.g. javascript)
      "formatEmbeds": true
    },
    "linter": {
      "enabled": true
    }
  },
  "yaml": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        // https://biomejs.dev/assist/actions/organize-imports/
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["cloudflare:*", ":NODE:", ":BUN:"],
              [
                "react",
                "react/**",
                "react*/**",
                "react-router",
                "react-router/**",
                "@react-router",
                "@react-router/**",
                "next",
                "next/**"
              ],
              [":URL:", ":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:", "!@workspace/**"],
              ":BLANK_LINE:",
              ["./+types/**", "*/+types/**"],
              ":BLANK_LINE:",
              ["@workspace/**", "!@workspace/ui/**"],
              ["@workspace/ui/**"],
              [":ALIAS:", ":PATH:"] // :ALIAS: covers #, @/, ~, $, or %
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "preset": "recommended"
      },
      "style": {
        "useImportType": "warn",
        "noParameterAssign": "off",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "cn": {
                "importNames": ["cn", "twMerge"],
                "message": "Import `cn` from '@workspace/ui/lib/style' because it is configured with custom theme tokens."
              }
            },
            "patterns": [
              {
                "group": ["**/node_modules/**", "*/node_modules/*"],
                "message": "Do not import directly from node_modules: this is likely an accidental auto-import that will break bundler."
              }
            ]
          }
        }
      },
      "correctness": {
        "noEmptyPattern": "off",
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "overrides": [
    // agent instructions and docs are lint-only (not formatted) because biome pads every row of a
    // markdown table to its widest cell (no option to disable) which makes wide tables hard to read
    {
      "includes": ["**/AGENTS.md", "**/CLAUDE.md", "docs/**", ".claude/**"],
      "markdown": {
        "formatter": {
          "enabled": false
        }
      }
    },
    // support component and props/value patterns that prefer indexed keys
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    // looser standards for shadcn cli managed components (for ease of maintainability / merging)
    {
      "includes": ["**/_shadcn/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noExplicitAny": "off"
          }
        }
      }
    },
    // loosen rules for tests to allow `any`
    {
      "includes": ["**/test*/**", "**/e2e/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "off",
            "useLiteralKeys": "off"
          },
          "correctness": {
            "noUnusedImports": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    // server code must use the logger (refer to docs/logging.md)
    {
      "includes": ["apps/*/app/**", "apps/*/workers/**", "packages/*/src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    // config files
    {
      "includes": ["**/drizzle.config.ts"],
      "linter": {
        "rules": {
          "nursery": {},
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    // ui components a11y
    {
      "includes": ["**/packages/ui/src/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            // most are aria-hidden or otherwise have default title
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "cn": {
                    "importNames": ["cn", "twMerge"],
                    "message": "Import `cn` from '@workspace/ui/lib/style' because it is configured with custom theme tokens."
                  }
                },
                "patterns": [
                  {
                    "group": ["**/node_modules/**"],
                    "message": "Do not import directly from node_modules."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
