{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "./workers/app.ts",
  "compatibility_date": "__COMPATIBILITY_DATE__",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // environment variables (default production; set per environment; see .dev.vars for local development overrides)
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "__SITE_URL__" // environment domain (e.g., preview, staging, production)
  }
}
