{
  "extends": "@workspace/tsconfig/react-router",
  "compilerOptions": {
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/workers/*": ["./workers/*"],
      "@/*": ["./app/*"]
    }
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules"]
}
