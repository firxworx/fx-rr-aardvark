{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    // since TypeScript 6 `DOM` includes `DOM.Iterable` and `DOM.AsyncIterable`
    "lib": ["DOM", "ESNext"],
    "strict": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false, // dev ergonomics (rr examples use true but it can be noisy in dev)
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    // side-effect imports such as `import './styles.css'` must resolve to a file or a module declaration
    // (`vite/client` types declare `*.css` and other asset modules)
    "noUncheckedSideEffectImports": true
  }
}
