{
  "extends": "@workspace/tsconfig/react-library",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      // still required?
      // "@workspace/ui/lib/utils": ["./src/lib/style"],
      "@workspace/ui/*": ["./src/*"]
    },
    "types": ["vite/client"]
