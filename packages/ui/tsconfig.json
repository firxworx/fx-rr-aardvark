  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "test/**/*.ts", "test/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "src/**/_wip/**/*"]
}
