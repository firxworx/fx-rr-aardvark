{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [],
  "ignoreDependencies": ["@napi-rs/image"],
  "workspaces": {
    "apps/web": {
      // `app/routes/**/*.{ts,tsx}` supports filesystem routes with `@react-router/fs-routes`
      // knip's react-router plugin is auto-detected per dependency in `apps/web/package.json`
      // the plugin contributes: `app/root.tsx`, `entry.client.tsx`, `entry.server.tsx`, `workers/app.ts`
      "entry": ["app/routes/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,css}"],

      // cloudflare no longer needs to be added to ignore cloudflare:* virtual modules (workerd built-ins)
      "ignoreDependencies": []
    },
    "packages/core": {
      "includeEntryExports": true
    },
    "packages/ui": {
      "includeEntryExports": true,
      "project": ["**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@tailwindcss/postcss", "@workspace/core", "react-router", "zod"]
    }
  },
  // ignore entries are resolved from the repo root
  "ignore": []
}
